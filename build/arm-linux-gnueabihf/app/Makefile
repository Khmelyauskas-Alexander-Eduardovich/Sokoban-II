####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/ || mkdir -p $(INSTALL_ROOT)/
	-$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/ 


install_ut_metadata: first FORCE
	@test -d $(INSTALL_ROOT)/ || mkdir -p $(INSTALL_ROOT)/
	-$(QINSTALL) /home/ubuntu/sokoban2/manifest.json $(INSTALL_ROOT)/manifest.json
	-$(QINSTALL) /home/ubuntu/sokoban2/sokoban2.desktop $(INSTALL_ROOT)/sokoban2.desktop
